{
  "name": "ui-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "props": "bun scripts/generate-props.ts",
    "previews": "bun scripts/generate-preview-code.ts",
    "predev": "bun run previews",
    "prebuild": "test -f ../../packages/ui/dist/index.js || bun run --cwd ../../packages/ui build; bun run props && bun run previews"
  },
  "dependencies": {
    "flexsearch": "^0.8.212",
    "fumadocs-core": "^16.15.12",
    "fumadocs-mdx": "^15.4.2",
    "fumadocs-ui": "^16.15.12",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rockin": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5",
    "zbsearch": "^4.0.0"
  }
}
